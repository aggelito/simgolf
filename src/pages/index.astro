---
import BaseLayout from '../components/BaseLayout.astro';
import { campaign, faqSchema, localBusinessSchema, memberships, prices, site } from '../data/golfoteket';

const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImage = `${basePath}/images/golfoteket-live/hero-golf-1600.webp`;
const offerImage = `${basePath}/images/golfoteket-live/opening-banner.webp`;
const precisionImage = `${basePath}/images/golfoteket-live/golfball-precision-1200.webp`;
const pingLogo = `${basePath}/images/golfoteket-live/ping-logo.png`;
const faqs = [
  ['När öppnar Golfoteket?', `Golfoteket öppnar ${campaign.opens} på Åsögatan 87, nära Medborgarplatsen på Södermalm.`],
  ['Vad kostar det?', 'Priset är per simulator och timme: 299 kr vardagar 06–14 och 399 kr vardagar 14–23 samt hela helgen.'],
  ['Ingår klubbor och bollar?', 'Ja. Ping G440-klubbor och bollar ingår. Det finns ett begränsat antal vänster-, dam- och juniorklubbor.'],
  ['Hur kommer jag in?', 'Golfoteket är en obemannad self-serviceanläggning. Dörrkoden skickas tillsammans med bokningen.'],
  ['Kan jag använda friskvårdsbidrag?', 'Ja, simulatorgolf hos Golfoteket är godkänt som friskvård.'],
  ['Kan företag boka?', 'Ja. Golfoteket passar för AW, kickoff, teambuilding och företagsevent. Hela lokalen eller flera simulatorer kan bokas efter förfrågan.'],
];
const schema = [
  {
    ...localBusinessSchema('Golfoteket öppnar 17 augusti 2026 på Södermalm med 6 Trackman iO-simulatorer och därefter öppet 06–23 varje dag.'),
    image: `${site.url}images/golfoteket-live/hero-golf-1600.webp`,
    makesOffer: [
      { '@type': 'Offer', name: 'Simulatorgolf vardagar 06–14', price: '299', priceCurrency: 'SEK', url: site.bookingUrl },
      { '@type': 'Offer', name: 'Simulatorgolf kväll och helg', price: '399', priceCurrency: 'SEK', url: site.bookingUrl },
      { '@type': 'Offer', name: 'Medlemskap 1 kr och första timmen 99 kr i öppningskampanjen', description: 'Kräver kampanjmedlemskap för 1 kr.', price: '99', priceCurrency: 'SEK', validFrom: '2026-08-17', validThrough: '2026-10-01', url: site.bookingUrl },
    ],
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', '@id': `${site.url}#website`, url: site.url, name: site.name, inLanguage: 'sv-SE' },
  faqSchema(faqs),
];
---
<BaseLayout
  title="Golfoteket | Simulatorgolf på Södermalm i Stockholm"
  description="Golfoteket öppnar 17 augusti på Åsögatan 87. 6 Trackman iO, därefter öppet 06–23 varje dag, klubbor ingår och priser från 299 kr."
  schema={schema}
>
  <section class="home-hero">
    <img class="home-hero-image" src={heroImage} alt="Golfotekets simulatorstudio på Södermalm" width="1536" height="1024" fetchpriority="high" decoding="async" />
    <div class="home-hero-shade"></div>
    <div class="home-hero-content section-shell">
      <p class="eyebrow">Åsögatan 87 · Södermalm</p>
      <h1>Golf.<br /><em>I alla väder.</em></h1>
      <p class="hero-lead">Sex Trackman iO-simulatorer mitt i Stockholm. Öppet 06–23 varje dag från 17 augusti 2026.</p>
      <div class="hero-actions">
        <a class="button primary" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Boka simulator</a>
        <a class="button light" href={`${basePath}/priser/`}>Se priser</a>
      </div>
    </div>
    <aside class="campaign-note">
      <span>Öppningserbjudande</span>
      <strong>Första timmen 99 kr</strong>
      <small>Gäller till 1 oktober</small>
    </aside>
  </section>

  <section class="proof-row section-shell" aria-label="Golfoteket i korthet">
    <p><strong>6</strong><span>Trackman iO</span></p>
    <p><strong>06–23</strong><span>från 17 augusti</span></p>
    <p><strong>299 kr</strong><span>från per timme</span></p>
    <p><strong>Ingår</strong><span>klubbor & bollar</span></p>
  </section>

  <section class="intro-editorial section-shell">
    <div>
      <p class="eyebrow">Golfoteket</p>
      <h2>Din golfstudio på Söder.</h2>
    </div>
    <div>
      <p class="large-copy">Spela världens banor, vässa svingen eller samla vännerna. Golfoteket ligger på Åsögatan 87, nära Medborgarplatsen, och kombinerar förstklassig teknik med ett enkelt self-serviceupplägg.</p>
      <a class="text-link" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Se lediga tider →</a>
    </div>
  </section>

  <section class="offer-story section-shell">
    <div class="offer-copy">
      <p class="eyebrow">Premiär 17 augusti</p>
      <h2>En mjukstart med riktigt bra golf.</h2>
      <p>Bli medlem för 1 kr och spela din första timme för 99 kr. Vill du fortsätta finns två öppningspass med extra bra timpris.</p>
      <div class="offer-lines">
        {campaign.offers.map(([name, price, detail]) => <p><span>{name}<small>{detail}</small></span><strong>{price}</strong></p>)}
      </div>
      <p class="fine-print">Öppningskampanjen gäller till 1 oktober 2026.</p>
      <a class="button primary" href={site.passesUrl} target="_blank" rel="noopener noreferrer">Se pass i Sweetspot</a>
    </div>
    <figure class="editorial-image">
      <img src={offerImage} alt="Golfotekets öppningskampanj med första timmen för 99 kr och rabatterade klippkort" width="799" height="1000" loading="lazy" decoding="async" />
    </figure>
  </section>

  <section class="technology">
    <div class="section-shell technology-grid">
      <figure><img src={precisionImage} alt="Golfboll framför en Trackman iO-simulator med 4K-projektion" width="1200" height="800" loading="lazy" /></figure>
      <div>
        <p class="eyebrow">Teknik som känns</p>
        <h2>Varje detalj. Varje slag.</h2>
        <p>Varje simulator har Trackman iO, 4K laserprojektor och skärm, separat analysskärm samt en 27-tums kontrollskärm. Du får snabb återkoppling och en naturtrogen spelupplevelse, oavsett om du tränar eller spelar en runda.</p>
        <p>Ping G440-klubbor och bollar ingår. Vänster-, dam- och juniorklubbor finns i begränsat antal.</p>
        <img class="ping-logo" src={pingLogo} alt="PING" width="128" height="54" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="how section-shell">
    <div class="section-heading">
      <p class="eyebrow">Så fungerar det</p>
      <h2>Tre steg till första utslaget.</h2>
    </div>
    <div class="steps">
      <article><span>01</span><h3>Boka online</h3><p>Välj tid och simulator direkt i Sweetspot.</p></article>
      <article><span>02</span><h3>Få din kod</h3><p>Dörrkoden skickas med bokningen till den obemannade studion.</p></article>
      <article><span>03</span><h3>Kom och spela</h3><p>Klubbor och bollar finns på plats. Din bokade simulator väntar.</p></article>
    </div>
  </section>

  <section class="price-section">
    <div class="section-shell price-layout">
      <div>
        <p class="eyebrow">Priser</p>
        <h2>Per simulator.<br />Inte per spelare.</h2>
        <p>Dela tiden och kostnaden med vänner eller kollegor. Aktiviteten är godkänd som friskvård.</p>
      </div>
      <div class="price-list">
        {prices.map(([time, price]) => <p><span>{time}</span><strong>{price}<small>/ timme</small></strong></p>)}
        <a href={`${basePath}/priser/`}>Alla priser och medlemskap →</a>
      </div>
    </div>
  </section>

  <section class="members-section section-shell">
    <div class="section-heading centered">
      <p class="eyebrow">Medlemskap</p>
      <h2>Mer golf för dig som spelar ofta.</h2>
      <p>Alla medlemskap gäller i ett år.</p>
    </div>
    <div class="membership-grid">
      {memberships.map((member) => (
        <article>
          <p>{member.name}</p><strong>{member.price}</strong>
          <span>{member.hours}</span><span>{member.discount}</span>
        </article>
      ))}
    </div>
    <div class="membership-extras">
      <p><strong>Personligt skåp</strong><span>1 995 kr/år</span></p>
      <p>Klippkort finns i Sweetspot för dig som vill spela flexibelt utan medlemskap.</p>
      <div><a class="button secondary" href={site.membershipsUrl} target="_blank" rel="noopener noreferrer">Se medlemskap</a><a class="text-link" href={site.passesUrl} target="_blank" rel="noopener noreferrer">Se klippkort →</a></div>
    </div>
  </section>

  <section class="location-band section-shell">
    <div>
      <p class="eyebrow">Hitta hit</p>
      <h2>Mitt på Södermalm.</h2>
      <address><strong>Golfoteket</strong><br />Åsögatan 87<br />118 29 Stockholm</address>
      <p>Nära tunnelbana och bussar vid Medborgarplatsen.</p>
      <a class="text-link" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">Öppna i Google Maps →</a>
    </div>
    <div class="location-mark" aria-hidden="true"><span>59°</span><strong>SÖDER</strong><small>Åsögatan 87</small></div>
  </section>

  <section class="business-section section-shell">
    <p class="eyebrow">Företag & event</p>
    <div><h2>Byt konferensrummet mot fairway.</h2><p>AW, kickoff, teambuilding eller företagsevent — boka flera simulatorer eller hela lokalen genom att skicka en förfrågan.</p><a class="button primary" href={`mailto:${site.email}?subject=Företag%20och%20event`}>Skicka en förfrågan</a></div>
  </section>

  <section class="faq section-shell">
    <div class="section-heading"><p class="eyebrow">Vanliga frågor</p><h2>Allt du behöver veta.</h2></div>
    <div class="faq-list">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
  </section>

  <section class="contact-section section-shell">
    <p class="eyebrow">Kontakt</p>
    <h2>Vi ses på Åsögatan.</h2>
    <a class="contact-email" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="social-links"><a href={site.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram</a><a href={site.socials.tiktok} target="_blank" rel="noopener noreferrer">TikTok</a><a href={site.socials.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></div>
  </section>

  <section class="final-cta section-shell">
    <p class="eyebrow">Öppnar 17 augusti</p>
    <h2>Redo för nästa runda?</h2>
    <p>Boka direkt i Sweetspot och möt oss på Södermalm.</p>
    <a class="button primary" href={site.bookingUrl} target="_blank" rel="noopener noreferrer">Boka simulator</a>
  </section>
</BaseLayout>
