---
import '../styles/global.css';

const sweetspotUrl = 'https://book.sweetspot.io/clubs/indoor-golf-group/961/tee-sheet';
const mapsUrl = 'https://maps.google.com/?q=Åsögatan+87+Stockholm';
const mapEmbedUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2036.5!2d18.0730!3d59.3140!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTnCsMxOJzUwLjQiTiAxOMKwMDQnMjIuOCJF!5e0!3m2!1ssv!2sse!4v1&q=Åsögatan+87+Stockholm';
const siteUrl = 'https://aggelito.github.io/simgolf/';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImage = `${basePath}/images/lovable/hero-golf-Uqf02GKW.jpg`;
const logoImage = `${basePath}/images/lovable/golfoteket-logo-new-l7jxXqlw.png`;
const socialImages = [
  `${basePath}/images/lovable/social-golf-1-C9vBYKiy.png`,
  `${basePath}/images/lovable/social-golf-2-D_7D_oIO.png`,
  `${basePath}/images/lovable/social-golf-3-m77PmL4w.png`,
  `${basePath}/images/lovable/social-golf-4-4t_Yhrt6.png`,
];
const ballImage = `${basePath}/images/lovable/golfball-precision-0fz6o5Ae.png`;
const absoluteHeroImage = `${siteUrl}images/lovable/hero-golf-Uqf02GKW.jpg`;

const nav = [
  ['Om oss', '#om-oss'],
  ['Lediga tider', '#lediga-tider'],
  ['Hitta hit', '#hitta-hit'],
  ['Så funkar det', '#sa-funkar-det'],
  ['Priser', '#priser'],
  ['Bli medlem', '#medlemskap'],
  ['Kontakta oss', '#kontakt'],
];

const heroStats = [
  ['screen', '6 Trackman iO\nSimulatorer'],
  ['club', 'Klubbor\ningår'],
  ['badge', 'Friskvård\nGodkänd'],
  ['users', 'Perfekt för\nalla nivåer'],
];

const aboutFeatures = [
  ['6 simulatorer', 'Trackman iO i varje bay med 4k Laser Projektor'],
  ['Öppet 06–23', 'Spela före jobbet, efter jobbet eller på helgen'],
  ['Klubbor & bollar ingår', 'Ping G440 och bollar finns på plats'],
  ['Boka enkelt via Sweetspot', 'Kod till dörren skickas vid bokning'],
];

const steps = [
  ['01', 'Boka tid', 'Välj simulator och tid i Sweetspot.'],
  ['02', 'Få dörrkod', 'Koden skickas automatiskt inför din bokning.'],
  ['03', 'Spela', 'Klubbor Ping G440 och bollar finns på plats.'],
];

const priceRows = [
  ['Mån–Fre 06:00–15:00', '349 kr/tim'],
  ['Mån–Fre 15:00–22:00', '499 kr/tim'],
  ['Lör–Sön hela dagen', '499 kr/tim'],
];

const membershipPerks = [
  ['Personligt skåp', 'Förvara dina egna klubbor på plats. De bästa golfarna har sina egna klubbor. Mejla oss för hyra av skåp, 245 kr i månaden.'],
  ['Klippkort', 'Köp klippkort och spara på varje session. Perfekt för den som spelar regelbundet.'],
  ['Medlemserbjudanden', 'Exklusiva erbjudanden, förtur till tider och rabatter på event.'],
];

const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'SportsActivityLocation'],
    '@id': `${siteUrl}#golfoteket`,
    name: 'Golfoteket',
    description: 'Golfoteket är ett modernt och exklusivt center för simulatorgolf på Södermalm, beläget på Åsögatan 87 i Stockholm. Här finns 6 Trackman iO-simulatorer, öppet 06–23 och bokning via Sweetspot.',
    url: siteUrl,
    image: absoluteHeroImage,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Åsögatan 87',
      postalCode: '118 29',
      addressLocality: 'Stockholm',
      addressRegion: 'Stockholm',
      addressCountry: 'SE',
    },
    openingHours: 'Mo-Su 06:00-23:00',
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: '6 Trackman iO simulatorer', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Ping G440-klubbor ingår', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Friskvård godkänt', value: true },
    ],
    makesOffer: [
      { '@type': 'Offer', name: 'Simulatorgolf från 349 kr/tim', url: sweetspotUrl },
      { '@type': 'Offer', name: 'Företag & Event', url: `${siteUrl}#kontakt` },
    ],
    potentialAction: {
      '@type': 'ReserveAction',
      target: sweetspotUrl,
      name: 'Boka simulator via Sweetspot',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: 'Golfoteket',
    url: siteUrl,
    inLanguage: 'sv-SE',
    about: { '@id': `${siteUrl}#golfoteket` },
  },
]);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light only" />
    <meta name="theme-color" content="#f2f0e9" />
    <meta name="supported-color-schemes" content="light" />
    <title>Golfoteket | Simulatorgolf på Södermalm i Stockholm</title>
    <meta name="description" content="Upplev världens bästa golfbanor på Golfoteket i Stockholm. Premium simulatorgolf med Trackman iO, 6 simulatorer, öppet 06–23 och bokning via Sweetspot." />
    <link rel="icon" href={`${basePath}/favicon.svg`} />
    <link rel="preload" as="image" href={heroImage} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content="Golfoteket | Simulatorgolf på Södermalm i Stockholm" />
    <meta property="og:description" content="Simulatorgolf på Södermalm med 6 Trackman iO, klubbor som ingår och öppet 06–23 varje dag." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={absoluteHeroImage} />
    <script is:inline type="application/ld+json" set:html={schema}></script>
  </head>
  <body>
    <header class="site-header lovable-header">
      <a class="lovable-logo" href="#top" aria-label="Golfoteket startsida">
        <img src={logoImage} alt="Golfoteket — Golf i alla väder" />
      </a>
      <nav aria-label="Huvudmeny">
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
        <a href="#top" aria-label="English version">◎ English</a>
        <a class="nav-cta" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka simulator</a>
      </nav>
    </header>

    <main id="top">
      <section class="lovable-hero" style={`--hero-image: url('${heroImage}')`}>
        <span class="hero-index">1</span>
        <div class="hero-content section-shell">
          <p class="eyebrow">Södermalm, Stockholm</p>
          <h1>Simulatorgolf<br />på Södermalm</h1>
          <div class="title-rule" aria-hidden="true"></div>
          <p class="open-label">Öppet</p>
          <p class="open-time">06–23</p>
          <p class="open-days">Varje dag</p>
          <p class="hero-lead">Golf är inte en hobby,<br />det är en livsstil.</p>
          <div class="hero-stats" aria-label="Snabbfakta">
            {heroStats.map(([icon, label]) => (
              <div class="hero-stat">
                <span class={`stat-icon icon-${icon}`} aria-hidden="true"></span>
                <strong>{label}</strong>
              </div>
            ))}
          </div>
          <div class="hero-actions stacked">
            <a class="button primary split" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">
              <span>Boka simulator</span>
              <small>Från 349 kr/tim</small>
              <b aria-hidden="true">→</b>
            </a>
            <a class="button primary ghost" href="#sa-funkar-det">Så funkar det</a>
          </div>
        </div>
      </section>

      <section class="about section-shell" id="om-oss">
        <div class="section-kicker">Om Golfoteket</div>
        <div class="split-grid">
          <div>
            <h2>Upplevelsen i centrum</h2>
            <p>Golfoteket är ett toppmodernt nyöppnat simulatorgolfstudio med den senaste tekniken för maximal precision och realism inom golfsimulering.</p>
            <ul class="bullet-list">
              <li>6 simulatorer</li>
              <li>Trackman iO</li>
              <li>Åsögatan 87</li>
              <li>Öppet 06–23</li>
              <li>Friskvård godkänt</li>
            </ul>
          </div>
          <div class="feature-list">
            {aboutFeatures.map(([title, desc]) => (
              <article>
                <h3>{title}</h3>
                <p>{desc}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="location section-shell" id="hitta-hit">
        <div class="section-kicker">Hitta hit</div>
        <div class="split-grid location-grid">
          <div>
            <h2>I hjärtat av Södermalm</h2>
            <address>
              <strong>Åsögatan 87</strong><br />
              118 29 Stockholm<br />
              Tunnelbanestation Medborgarplatsen
            </address>
            <a class="button secondary" href={mapsUrl} target="_blank" rel="noopener noreferrer">Öppna i Google Maps</a>
          </div>
          <div class="map-card">
            <iframe src={mapEmbedUrl} title="Golfoteket karta" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </section>

      <section class="social section-shell">
        <div class="section-kicker">Socialt</div>
        <div class="split-grid">
          <div>
            <h2>Golf för alla tillfällen</h2>
            <p>Golf handlar inte bara om träning eller en stenhård hobby — det är även en social upplevelse. Därför har vi möjliggjort för er att ta med egen dryck till golfandet, såsom ett gott glas vin eller några iskalla öl.</p>
          </div>
          <div class="photo-grid">
            {socialImages.map((src, index) => <img src={src} alt={`Golfoteket social miljö ${index + 1}`} loading="lazy" />)}
          </div>
        </div>
      </section>

      <section class="tech section-shell">
        <div class="section-kicker">Tekniken</div>
        <div class="split-grid tech-grid">
          <div>
            <h2>Precision i varje slag</h2>
            <p>Banorna är utrustade med en 4K spelskärm som möter hela 4×2,5 meter för maximal spelupplevelse. Till detta har vi analysskärm för att få direkt feedback på din sving, samt en 27&quot; kontrollskärm för smidig navigering runt de 18 hålen.</p>
            <p>Vi använder oss av den senaste tekniken Trackman iO — som är uppgraderingen av Trackman 4. Utrustad med höghastighetskamera och bättre precision för ännu mer träffsäker analys av dina slag.</p>
            <p>Komplett set med Ping-klubbor och bollar finns på plats utan extra kostnad.</p>
          </div>
          <img src={ballImage} alt="Golfboll och teknisk precision hos Golfoteket" loading="lazy" />
        </div>
      </section>

      <section class="how section-shell" id="sa-funkar-det">
        <div class="section-kicker">Så enkelt är det</div>
        <div class="section-heading centered">
          <h2>Hur funkar det?</h2>
          <p>Ping Premium G440-klubbor och bollar finns på plats att låna utan extra kostnad till alla våra gäster. Vi har även begränsat med klubbor för vänsterspelare, dam och barn.</p>
        </div>
        <div class="steps">
          {steps.map(([number, title, text]) => (
            <article>
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
        <div class="center-action"><a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka simulator</a></div>
      </section>

      <section class="pricing section-shell" id="priser">
        <div class="section-kicker">Priser</div>
        <div class="split-grid">
          <div>
            <h2>Golf för alla</h2>
            <p>Priset är per simulator per timme — dela kostnaden med dina vänner eller kollegor. Inga extra avgifter per spelare.</p>
          </div>
          <div class="price-card">
            {priceRows.map(([label, price]) => (
              <div class="price-row">
                <span>{label}</span>
                <strong>{price}</strong>
              </div>
            ))}
            <p class="wellness">Godkänd som friskvård</p>
          </div>
        </div>
      </section>

      <section class="membership section-shell" id="medlemskap">
        <div class="section-kicker">Medlemskap</div>
        <div class="section-heading centered">
          <h2>Bli medlem</h2>
          <p>Spelar du ofta? Med medlemskap och klippkort får du bättre värde per runda, smidig bokning och möjlighet att hyra personligt skåp för dina egna klubbor.</p>
        </div>
        <div class="perk-grid">
          {membershipPerks.map(([title, text]) => (
            <article>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
        <div class="center-action"><a class="button secondary" href="#kontakt">Kontakta oss</a></div>
      </section>

      <section class="available section-shell" id="lediga-tider">
        <div class="section-heading centered">
          <h2>Lediga tider idag</h2>
          <p>Tillgängliga tider idag — Bokning sker via Sweetspot!</p>
        </div>
        <div class="booking-frame">
          <iframe src={sweetspotUrl} title="Boka tid på Sweetspot" loading="lazy"></iframe>
        </div>
        <p class="fallback">Om tiderna inte visas, <a href={sweetspotUrl} target="_blank" rel="noopener noreferrer">klicka här för att se dem på Sweetspot</a>.</p>
      </section>

      <section class="contact section-shell" id="kontakt">
        <div class="section-kicker">Kontakta oss</div>
        <div class="split-grid">
          <div>
            <h2>Företag & Event</h2>
            <p>Planerar ni en AW, kickoff, teambuilding eller firmaevent? Boka hela lokalen eller ett paket med flertalet banor. Kontakta oss så berättar vi mer.</p>
          </div>
          <div class="contact-card">
            <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka tid på Sweetspot</a>
            <a class="button secondary" href={mapsUrl} target="_blank" rel="noopener noreferrer">Hitta till Åsögatan 87</a>
          </div>
        </div>
      </section>

      <section class="about-company section-shell">
        <h2>Om oss som bolag</h2>
        <p>Välkommen till Golfoteket – ett modernt och exklusivt center för simulatorgolf på Södermalm, beläget på Åsögatan 87 i Stockholm. Här kombineras avancerad teknik, golfträning och en social atmosfär i en miljö skapad för både erfarna golfare och nybörjare.</p>
        <p>Hos oss handlar golf om mer än bara träning. Golfoteket är en mötesplats för dig som vill spela indoor golf i Stockholm, utveckla ditt spel eller umgås med vänner och kollegor i en unik miljö.</p>
        <p>Anläggningen är utrustad med sex premiumsimulatorer med den senaste Trackman iO-tekniken, vilket ger en realistisk och träffsäker golfupplevelse. Boka din tid idag och upplev nästa nivå av simulatorgolf på Södermalm.</p>
      </section>
    </main>

    <footer>
      <strong>Golfoteket</strong>
      <span>Alla rättigheter förbehållna.</span>
      <a href="#top">Om oss som bolag</a>
    </footer>
  </body>
</html>
