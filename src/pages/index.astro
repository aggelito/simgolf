---
import '../styles/global.css';

const sweetspotUrl = 'https://book.sweetspot.io/clubs/indoor-golf-group/961/tee-sheet';
const mapsUrl = 'https://maps.google.com/?q=Åsögatan+87+Stockholm';
const mapEmbedUrl = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2036.5!2d18.0730!3d59.3140!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNTnCsMxOJzUwLjQiTiAxOMKwMDQnMjIuOCJF!5e0!3m2!1ssv!2sse!4v1&q=Åsögatan+87+Stockholm';
const siteUrl = 'https://aggelito.github.io/simgolf/';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImage = `${basePath}/images/lovable/hero-golf-Uqf02GKW.jpg`;
const logoImage = `${basePath}/images/lovable/golfoteket-logo-new-l7jxXqlw.png`;
const socialImages = [
  `${basePath}/images/lovable/social-golf-1-C9vBYKiy.png`,
  `${basePath}/images/lovable/social-golf-2-D_7D_oIO.png`,
  `${basePath}/images/lovable/social-golf-3-m77PmL4w.png`,
  `${basePath}/images/lovable/social-golf-4-4t_Yhrt6.png`,
];
const absoluteHeroImage = `${siteUrl}images/lovable/hero-golf-Uqf02GKW.jpg`;

const nav = [
  ['Boka', '#boka'],
  ['Priser', '#priser'],
  ['Så funkar det', '#sa-funkar-det'],
  ['Företag', '#foretag'],
  ['Hitta hit', '#hitta-hit'],
];

const proof = [
  ['6', 'Trackman iO-simulatorer'],
  ['06–23', 'öppet varje dag'],
  ['349 kr', 'från per timme'],
  ['Åsögatan 87', 'Södermalm'],
];

const useCases = [
  ['Spela en runda', 'Boka en simulator, välj bana och spela 9 eller 18 hål när vädret inte levererar.', 'Boka runda'],
  ['Träna med data', 'Trackman iO ger feedback på bollflykt, längd, riktning och träff så du vet vad som faktiskt händer.', 'Boka träning'],
  ['Ta med gänget', 'Perfekt för kompisar, kollegor och grupper som vill göra något roligare än ännu en vanlig aktivitet.', 'Boka grupp'],
];

const steps = [
  ['01', 'Välj tid', 'Öppna Sweetspot och välj simulatorn som passar dig.'],
  ['02', 'Få access', 'Dörrkod och instruktioner skickas inför bokningen.'],
  ['03', 'Pegga upp', 'Klubbor och bollar finns på plats. Spela, träna och lämna snyggt efter dig.'],
];

const priceRows = [
  ['Mån–Fre 06:00–15:00', '349 kr/tim'],
  ['Mån–Fre 15:00–22:00', '499 kr/tim'],
  ['Lör–Sön hela dagen', '499 kr/tim'],
];

const faqs = [
  ['Behöver jag ta med klubbor?', 'Nej, Ping G440-klubbor och bollar finns på plats. Det finns även begränsat med klubbor för vänsterspelare, dam och barn enligt nuvarande upplägg.'],
  ['Är priset per person?', 'Nej, priset är per simulator och timme. Dela kostnaden mellan spelarna.'],
  ['Är Golfoteket bemannat?', 'Upplägget är self-service. Du bokar online, får accessinstruktioner och spelar under din bokade tid.'],
  ['Passar det nybörjare?', 'Ja. Simulatorgolf fungerar både för nybörjare och vana golfare — spela lugnt, träna eller tävla mot kompisarna.'],
];

const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'SportsActivityLocation'],
    '@id': `${siteUrl}#golfoteket`,
    name: 'Golfoteket',
    description: 'Golfoteket är en simulatorgolfstudio på Södermalm i Stockholm med 6 Trackman iO-simulatorer, öppet 06–23 och bokning online via Sweetspot.',
    url: siteUrl,
    image: absoluteHeroImage,
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Åsögatan 87',
      postalCode: '118 29',
      addressLocality: 'Stockholm',
      addressCountry: 'SE',
    },
    openingHours: 'Mo-Su 06:00-23:00',
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: '6 Trackman iO simulatorer', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Klubbor och bollar ingår', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Friskvård godkänt', value: true },
    ],
    makesOffer: [
      { '@type': 'Offer', name: 'Simulatorgolf från 349 kr/tim', url: sweetspotUrl },
      { '@type': 'Offer', name: 'Golfträning inomhus', url: sweetspotUrl },
      { '@type': 'Offer', name: 'Gruppbokning simulatorgolf', url: sweetspotUrl },
    ],
    potentialAction: { '@type': 'ReserveAction', target: sweetspotUrl, name: 'Boka simulatorgolf via Sweetspot' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map(([question, answer]) => ({
      '@type': 'Question',
      name: question,
      acceptedAnswer: { '@type': 'Answer', text: answer },
    })),
  },
]);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#08130d" />
    <title>Golfoteket — Boka simulatorgolf på Södermalm</title>
    <meta name="description" content="Boka simulatorgolf på Södermalm. Golfoteket har 6 Trackman iO-simulatorer, öppet 06–23 varje dag, klubbor som ingår och tider från 349 kr/tim." />
    <link rel="icon" href={`${basePath}/favicon.svg`} />
    <link rel="preload" as="image" href={heroImage} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content="Golfoteket — Boka simulatorgolf på Södermalm" />
    <meta property="og:description" content="6 Trackman iO-simulatorer, öppet 06–23 och bokning online via Sweetspot." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={absoluteHeroImage} />
    <script is:inline type="application/ld+json" set:html={schema}></script>
  </head>
  <body>
    <a class="skip-link" href="#boka">Gå direkt till bokning</a>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Golfoteket startsida">
        <img src={logoImage} alt="Golfoteket" />
      </a>
      <nav aria-label="Huvudmeny">
        {nav.map(([label, href]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="header-cta" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka nu</a>
    </header>

    <main id="top">
      <section class="hero" style={`--hero-image: url('${heroImage}')`}>
        <div class="hero-inner section-shell">
          <div class="hero-copy">
            <p class="eyebrow">Simulatorgolf på Södermalm • öppet 06–23</p>
            <h1>Boka golf när du faktiskt vill spela.</h1>
            <p class="hero-lead">6 Trackman iO-simulatorer på Åsögatan 87. Klubbor och bollar finns på plats. Boka online, få access och spela året runt.</p>
            <div class="hero-actions">
              <a class="button primary xl" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Se lediga tider →</a>
              <a class="button secondary" href="#priser">Se priser</a>
            </div>
            <div class="micro-proof" aria-label="Snabbfakta">
              <span>Från 349 kr/tim</span>
              <span>Friskvård godkänt</span>
              <span>Klubbor ingår</span>
            </div>
          </div>

          <aside class="booking-card" aria-label="Boka Golfoteket">
            <p class="card-label">Nästa slag</p>
            <h2>Boka på under en minut.</h2>
            <p>Välj tid i Sweetspot. Priset är per simulator och timme — ta med en kompis och dela kostnaden.</p>
            <a class="button primary full" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Öppna bokningen</a>
            <div class="booking-facts">
              <span>06–23 varje dag</span>
              <span>6 simulatorer</span>
              <span>Södermalm</span>
            </div>
          </aside>
        </div>
      </section>

      <section class="proof-strip section-shell" aria-label="Varför boka Golfoteket">
        {proof.map(([value, label]) => (
          <div>
            <strong>{value}</strong>
            <span>{label}</span>
          </div>
        ))}
      </section>

      <section class="booking-section section-shell" id="boka">
        <div class="section-intro tight">
          <p class="eyebrow">Lediga tider</p>
          <h2>Sluta scrolla. Boka tiden.</h2>
          <p>Det här är pengahålet: bokningen ligger högt upp, tydligt och nära. Om kalendern inte laddar öppnar knappen Sweetspot direkt.</p>
          <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka direkt i Sweetspot</a>
        </div>
        <div class="booking-frame">
          <iframe src={sweetspotUrl} title="Boka simulatorgolf hos Golfoteket via Sweetspot" loading="lazy"></iframe>
        </div>
      </section>

      <section class="use-cases section-shell" id="om-oss">
        <div class="section-intro centered">
          <p class="eyebrow">Välj ditt spel</p>
          <h2>Tre enkla skäl att boka.</h2>
        </div>
        <div class="card-grid three">
          {useCases.map(([title, text, cta]) => (
            <article class="cash-card">
              <h3>{title}</h3>
              <p>{text}</p>
              <a href={sweetspotUrl} target="_blank" rel="noopener noreferrer">{cta} →</a>
            </article>
          ))}
        </div>
      </section>

      <section class="price-band" id="priser">
        <div class="section-shell price-grid">
          <div>
            <p class="eyebrow">Priser</p>
            <h2>Enkelt val. Hög spelglädje.</h2>
            <p>Priset är per simulator och timme. Inga extra avgifter per spelare — dela kostnaden mellan spelarna och få mer golf för pengarna.</p>
            <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka från 349 kr/tim</a>
          </div>
          <div class="price-card">
            {priceRows.map(([label, price]) => (
              <div class="price-row">
                <span>{label}</span>
                <strong>{price}</strong>
              </div>
            ))}
            <p class="wellness">Godkänd som friskvård</p>
          </div>
        </div>
      </section>

      <section class="how section-shell" id="sa-funkar-det">
        <div class="section-intro centered">
          <p class="eyebrow">Så funkar det</p>
          <h2>Boka. Kom in. Spela.</h2>
        </div>
        <div class="steps">
          {steps.map(([number, title, text]) => (
            <article>
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="image-sell section-shell">
        <div class="image-stack">
          <img src={socialImages[0]} alt="Golfotekets simulatorstudio" loading="lazy" />
          <img src={socialImages[1]} alt="Simulatorgolf hos Golfoteket" loading="lazy" />
        </div>
        <div>
          <p class="eyebrow">Premiumkänsla</p>
          <h2>Mer golfstudio. Mindre aktivitetslokal.</h2>
          <p>Golfoteket ska kännas som ett självklart ställe att boka igen. Riktiga simulatorer, tydligt upplägg, central plats och en sida som driver kunden mot bokning utan att krångla.</p>
          <ul class="check-list">
            <li>Trackman iO i varje bay</li>
            <li>4K-spelskärm och analysskärm</li>
            <li>Ping G440-klubbor och bollar på plats</li>
          </ul>
          <a class="button secondary dark" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka nästa runda</a>
        </div>
      </section>

      <section class="business-band section-shell" id="foretag">
        <div>
          <p class="eyebrow">Företag & grupper</p>
          <h2>AW, kickoff eller kompisrunda som folk faktiskt snackar om.</h2>
        </div>
        <div>
          <p>Boka flera banor eller samla gänget runt simulatorgolf. Enkelt att förstå, lätt att boka och betydligt roligare än standardaktiviteten.</p>
          <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Kolla lediga tider</a>
        </div>
      </section>

      <section class="location section-shell" id="hitta-hit">
        <div>
          <p class="eyebrow">Hitta hit</p>
          <h2>Åsögatan 87, Södermalm.</h2>
          <address>
            <strong>Golfoteket</strong><br />
            Åsögatan 87<br />
            118 29 Stockholm<br />
            Tunnelbanestation Medborgarplatsen
          </address>
          <a class="button secondary" href={mapsUrl} target="_blank" rel="noopener noreferrer">Öppna i Google Maps</a>
        </div>
        <div class="map-card">
          <iframe src={mapEmbedUrl} title="Golfoteket karta" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </section>

      <section class="faq section-shell">
        <div class="section-intro centered">
          <p class="eyebrow">Bra att veta</p>
          <h2>Friktion dödar bokningar. Här är svaren.</h2>
        </div>
        <div class="faq-list">
          {faqs.map(([question, answer]) => (
            <details>
              <summary>{question}</summary>
              <p>{answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="final-cta section-shell">
        <p class="eyebrow">Redo?</p>
        <h2>Boka Golfoteket nu.</h2>
        <p>Välj tid, pegga upp och slå första slaget. Nu går vi rakt mot fairway.</p>
        <a class="button primary xl" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Se lediga tider →</a>
      </section>
    </main>

    <a class="mobile-booking" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka simulator</a>

    <footer>
      <strong>Golfoteket</strong>
      <span>Simulatorgolf på Södermalm • öppet 06–23 varje dag</span>
    </footer>
  </body>
</html>
