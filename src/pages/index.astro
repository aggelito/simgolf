---
import '../styles/global.css';

const sweetspotUrl = 'https://book.sweetspot.io/clubs/indoor-golf-group/961/tee-sheet';
const siteUrl = 'https://aggelito.github.io/simgolf/';
const stockholmUrl = 'https://aggelito.github.io/simgolf/simulatorgolf-stockholm/';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const heroImage = `${basePath}/images/golfoteket-studio.png`;
const absoluteHeroImage = `${siteUrl}images/golfoteket-studio.png`;

const facts = [
  ['Plats', 'Södermalm, Stockholm'],
  ['Öppet', '06.00–23.00'],
  ['Studio', '6 simulatorbanor'],
  ['Teknik', 'Trackman iO'],
];

const offers = [
  ['Spela året runt', 'Välj bana, pegga upp och spela oavsett väder. En riktig golfkänsla mitt på Södermalm.'],
  ['Träna med data', 'Trackman iO ger tydlig feedback på bollflykt, längd och riktning när du vill slipa svingen.'],
  ['Ta med gänget', 'Passar kompisrundor, kollegor och gruppbokningar utan att göra bokningen krånglig.'],
];

const steps = [
  ['01', 'Boka online', 'Välj tid och simulator i Sweetspot.'],
  ['02', 'Kom in', 'Följ accessinstruktionerna för din bokade tid.'],
  ['03', 'Spela', 'Klubbor och bollar finns på plats. Lämna studion snygg för nästa spelare.'],
];

const prices = [
  ['Mån–fre 06.00–15.00', '349 kr/tim'],
  ['Mån–fre 15.00–22.00', '499 kr/tim'],
  ['Lör–sön hela dagen', '499 kr/tim'],
];

const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'SportsActivityLocation'],
    '@id': `${siteUrl}#golfoteket`,
    name: 'Golfoteket',
    description: 'Golfoteket är en simulatorgolfstudio på Södermalm i Stockholm med 6 simulatorbanor, Trackman iO, öppet 06.00–23.00 och bokning online via Sweetspot.',
    url: siteUrl,
    image: absoluteHeroImage,
    areaServed: [
      { '@type': 'City', name: 'Stockholm' },
      { '@type': 'Place', name: 'Södermalm' },
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Stockholm',
      addressRegion: 'Stockholm',
      addressCountry: 'SE',
    },
    openingHours: 'Mo-Su 06:00-23:00',
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: '6 simulatorbanor', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Trackman iO', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Self-service access', value: true },
    ],
    makesOffer: [
      { '@type': 'Offer', name: 'Simulatorgolf per timme', url: sweetspotUrl },
      { '@type': 'Offer', name: 'Golfträning inomhus', url: stockholmUrl },
      { '@type': 'Offer', name: 'Gruppbokning simulatorgolf', url: sweetspotUrl },
    ],
    potentialAction: {
      '@type': 'ReserveAction',
      target: sweetspotUrl,
      name: 'Boka simulatorgolf via Sweetspot',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${siteUrl}#website`,
    name: 'Golfoteket',
    url: siteUrl,
    inLanguage: 'sv-SE',
    about: { '@id': `${siteUrl}#golfoteket` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Var kan man spela simulatorgolf i Stockholm?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Golfoteket på Södermalm i Stockholm erbjuder simulatorgolf med 6 simulatorbanor, Trackman iO och bokning online via Sweetspot.',
        },
      },
      {
        '@type': 'Question',
        name: 'Har Golfoteket Trackman?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Ja, Golfoteket använder Trackman iO för simulatorgolf och golfträning.',
        },
      },
      {
        '@type': 'Question',
        name: 'Hur bokar man simulatorgolf hos Golfoteket?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Du bokar tid online via Sweetspot, får instruktioner för access och spelar under din bokade tid.',
        },
      },
    ],
  },
]);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Golfoteket — Simulatorgolf på Södermalm</title>
    <meta name="description" content="Boka simulatorgolf på Södermalm hos Golfoteket. 6 simulatorbanor, Trackman iO, öppet 06.00–23.00 och smidig bokning via Sweetspot." />
    <meta name="theme-color" content="#ece8de" />
    <link rel="icon" href={`${basePath}/favicon.svg`} />
    <link rel="preload" as="image" href={heroImage} />
    <link rel="canonical" href={siteUrl} />
    <meta property="og:title" content="Golfoteket — Simulatorgolf på Södermalm" />
    <meta property="og:description" content="Boka simulatorgolf året runt. 6 simulatorbanor, Trackman iO och öppet 06.00–23.00." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={absoluteHeroImage} />
    <script is:inline type="application/ld+json" set:html={schema}></script>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', storedTheme ? storedTheme === 'dark' : prefersDark);
    </script>
  </head>
  <body>
    <header class="site-header photo-header">
      <a class="brand" href="#top" aria-label="Golfoteket startsida">
        <span class="brand-name">Golfoteket</span>
        <span class="brand-tag">Golf i alla väder</span>
      </a>
      <nav aria-label="Huvudmeny">
        <a href="#studion">Om oss</a>
        <a href="#sa-funkar-det">Hur funkar det</a>
        <a href={`${basePath}/priser/`}>Priser</a>
        <a href="#hitta-hit">Hitta hit</a>
        <a href="#medlem">Bli medlem</a>
        <a href="#kontakt">Kontakta oss</a>
        <a href="#top" aria-label="English version">🌐 English</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Växla mellan mörkt och ljust läge">Mörkt</button>
        <a class="nav-cta" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka nu</a>
      </nav>
    </header>

    <main id="top">
      <section class="hero-photo" style={`--hero-image: url('${heroImage}')`}>
        <div class="hero-overlay section-shell">
          <p class="eyebrow">Södermalm, Stockholm</p>
          <h1>Golf är inte en hobby, det är en livsstil.</h1>
          <p class="hero-lead">Välkommen till Golfoteket. Stockholms senaste mötesplats för golf, i hjärtat av Södermalm. Med Trackman iO, 6 simulatorbanor och öppet alla dagar året runt 06.00–23.00.</p>
          <div class="hero-actions">
            <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka nu →</a>
            <a class="button secondary" href="#medlem">Bli medlem</a>
          </div>
        </div>
      </section>

      <section class="fact-strip section-shell" aria-label="Snabbfakta">
        {facts.map(([label, value]) => (
          <div>
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </section>

      <section class="intro section-shell" id="studion">
        <div>
          <p class="eyebrow">Om oss</p>
          <h2>En mötesplats för golfare, inte en generisk aktivitetslokal.</h2>
        </div>
        <div>
          <p>Golfoteket är byggt runt själva golfen: tydliga simulatorbås, premiumkänsla, enkel bokning och en plats där du kan spela, träna och umgås utan att vädret får bestämma. Designen är renare, ljusare och närmare Lukas gamla uttryck — men bokningsknappen ligger fortfarande där den ska.</p>
          <a class="text-link" href={`${basePath}/simulatorgolf-stockholm/`}>Läs mer om simulatorgolf i Stockholm →</a>
        </div>
      </section>

      <section class="offer-grid section-shell" aria-label="Vad du kan göra hos Golfoteket">
        {offers.map(([title, text]) => (
          <article>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </section>

      <section class="image-break section-shell">
        <img src={heroImage} alt="Golfotekets simulatorgolfstudio med flera simulatorbanor, lounge och Trackman-skärmar" loading="lazy" />
      </section>

      <section class="how section-shell" id="sa-funkar-det">
        <div class="section-heading">
          <p class="eyebrow">Hur funkar det</p>
          <h2>Boka. Kom in. Spela.</h2>
        </div>
        <div class="steps">
          {steps.map(([number, title, text]) => (
            <article>
              <span>{number}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="pricing section-shell" id="priser">
        <div>
          <p class="eyebrow">Priser</p>
          <h2>Pris per simulator och timme.</h2>
          <p>Dela kostnaden mellan spelarna. Enkelt upplägg, tydlig bokning och inga påhittade paket som gör valet svårare.</p>
        </div>
        <div class="price-card">
          {prices.map(([label, price]) => (
            <div class="price-row">
              <span>{label}</span>
              <strong>{price}</strong>
            </div>
          ))}
          <p class="wellness">Golfoteket är godkänt som friskvård enligt nuvarande upplägg.</p>
        </div>
      </section>

      <section class="ai-facts section-shell" id="medlem" aria-label="Medlemskap">
        <p class="eyebrow">Bli medlem</p>
        <h2>För dig som vill spela oftare.</h2>
        <p>Medlemskap kan lyftas här när upplägget är spikat. Tills dess håller vi budskapet ärligt: boka en tid i Sweetspot och använd studion när du vill spela eller träna.</p>
      </section>

      <section class="booking section-shell" id="boka">
        <div class="booking-copy">
          <p class="eyebrow">Boka tid</p>
          <h2>Se lediga tider i Sweetspot.</h2>
          <p>Det viktigaste på sidan är att bokningen är nära hela tiden. Öppna kalendern, välj tid och pegga upp.</p>
          <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Öppna Sweetspot</a>
        </div>
        <div class="booking-frame">
          <iframe
            src={sweetspotUrl}
            title="Boka simulatorgolf hos Golfoteket via Sweetspot"
            loading="lazy"
          ></iframe>
        </div>
      </section>

      <section class="ai-facts section-shell" id="hitta-hit" aria-label="Fakta om Golfoteket">
        <p class="eyebrow">Hitta hit</p>
        <h2>Simulatorgolf i Stockholm, mitt på Södermalm.</h2>
        <p>Golfoteket är en simulatorgolfstudio på Södermalm i Stockholm. Här bokar du simulatorgolf online via Sweetspot, spelar året runt och tränar med Trackman iO i en self-service golfstudio med 6 simulatorbanor.</p>
      </section>

      <section class="faq section-shell" id="faq">
        <p class="eyebrow">Bra att veta</p>
        <details open>
          <summary>Är Golfoteket bemannat?</summary>
          <p>Upplägget är self-service. Du bokar tid, får instruktioner för access och spelar under din bokade tid.</p>
        </details>
        <details>
          <summary>Passar det nybörjare?</summary>
          <p>Ja. Simulatorgolf fungerar både för nybörjare och vana golfare. Ta det som träning, spel eller en social utmaning.</p>
        </details>
        <details>
          <summary>Finns klubbor och bollar?</summary>
          <p>Standardset från Callaway och Titleist Pro V1 WHT-bollar finns kostnadsfritt på plats. Klubbor för vänsterspelare, dam och barn finns också enligt nuvarande upplägg.</p>
        </details>
        <details>
          <summary>Har ni bar?</summary>
          <p>Nej. Golfoteket är en golfstudio med fokus på simulatorgolf, träning och spel.</p>
        </details>
      </section>

      <section class="final-cta section-shell" id="kontakt">
        <p class="eyebrow">Kontakta oss</p>
        <h2>Boka simulatorgolf hos Golfoteket.</h2>
        <p>En riktig studio, tydlig bokning och golf året runt — utan att krångla till det.</p>
        <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka i Sweetspot</a>
      </section>
    </main>

    <footer>
      <strong>Golfoteket</strong>
      <span>Simulatorgolf på Södermalm — öppet 06.00–23.00.</span>
    </footer>
    <script is:inline>
      const toggle = document.querySelector('[data-theme-toggle]');
      const setLabel = () => {
        if (toggle) toggle.textContent = document.documentElement.classList.contains('dark') ? 'Ljust' : 'Mörkt';
      };
      setLabel();
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        setLabel();
      });
    </script>
  </body>
</html>
