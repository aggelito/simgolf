---
import SeoLanding from '../components/SeoLanding.astro';
import { site } from '../data/golfoteket';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faqs = [
  ['Passar Golfoteket för företagsevent?', 'Ja. Lokalen passar för AW, kickoff, teambuilding och företagsevent.'],
  ['Kan vi boka hela lokalen?', 'Ja. Hela lokalen eller flera simulatorer kan bokas efter förfrågan.'],
  ['Kan nybörjare vara med?', 'Ja. Simulatorgolf passar både nybörjare och vana golfare, och klubbor samt bollar ingår.'],
];
---
<SeoLanding
  title="Företagsevent golf i Stockholm — Golfoteket"
  description="Boka simulatorgolf för AW, kickoff, teambuilding och företagsevent på Södermalm. Förfrågan för hela lokalen eller flera simulatorer."
  path="foretagsevent-golf/"
  eyebrow="Företagsevent golf Stockholm"
  heading="Ett event som träffar rätt."
  lead="Samla kollegor eller kunder för simulatorgolf på Södermalm. Boka flera simulatorer eller hela Golfoteket för AW, kickoff och teambuilding."
  answerHeading="Kan man boka simulatorgolf för företag i Stockholm?"
  answer="Ja. Golfoteket har 6 Trackman iO-simulatorer på Åsögatan 87 och tar emot förfrågningar för flera simulatorer eller hela lokalen."
  articles={[
    { title: 'För team, kunder och kollegor', paragraphs: ['Blanda virtuella banor med longest drive eller närmast flagg. Upplägget fungerar för både nybörjare och vana golfare.', 'Ping G440-klubbor och bollar ingår, så deltagarna behöver inte ta med egen utrustning.'] },
    { title: 'Planera rätt antal simulatorer', paragraphs: ['Mindre grupper kan boka direkt i Sweetspot. För hela lokalen, flera simulatorer eller ett särskilt upplägg skickar ni en förfrågan till Golfoteket.', 'Studion öppnar 17 augusti och är därefter öppen 06–23 varje dag, vilket ger gott om alternativ för frukostaktivitet, AW eller kickoff.'] },
  ]}
  cards={[
    { title: 'Skicka förfrågan', text: 'Berätta datum, tid och ungefärlig gruppstorlek.', label: 'Kontakta Golfoteket', href: `mailto:${site.email}?subject=Företagsevent` },
    { title: 'Se priser', text: 'Ordinarie pris gäller per simulator och timme.', label: 'Till prislistan', href: `${base}/priser/` },
    { title: 'Boka direkt', text: 'För mindre grupper och vanliga tider.', label: 'Öppna Sweetspot', href: site.bookingUrl },
  ]}
  faqs={faqs}
/>
