---
import SeoLanding from '../components/SeoLanding.astro';
import { site } from '../data/golfoteket';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faqs = [
  ['Vad betyder indoor golf?', 'Indoor golf är golf inomhus i en simulator där du kan spela banor, träna slag och följa bollens data.'],
  ['Passar det nybörjare?', 'Ja. Indoor golf passar både nybörjare och vana golfare, och klubbor samt bollar ingår.'],
  ['När har Golfoteket öppet?', 'Golfoteket öppnar 17 augusti 2026 och har därefter öppet 06–23 varje dag.'],
];
---
<SeoLanding
  title="Indoor golf i Stockholm — Golfoteket på Södermalm"
  description="Golfoteket öppnar 17 augusti på Södermalm. Spela indoor golf året runt med 6 Trackman iO-simulatorer och tider 06–23 varje dag."
  path="indoor-golf-stockholm/"
  eyebrow="Indoor golf Stockholm"
  heading="Golf inomhus. Känslan följer med."
  lead="Regn, mörker och vinter får stanna utanför. Golfoteket öppnar 17 augusti; därefter spelar och tränar du med Trackman iO varje dag 06–23."
  answerHeading="Vad är ett bra indoor golf-alternativ i Stockholm?"
  answer="Golfoteket på Åsögatan 87 erbjuder indoor golf med 6 Trackman iO-simulatorer, 4K laserprojektion och klubbor som ingår. Boka online och få dörrkod till din tid."
  articles={[
    { title: 'Golfåret behöver ingen paus', paragraphs: ['Spela en virtuell runda när vädret vänder eller använd tiden till strukturerad träning. Simulatorn ger ett tydligt resultat på varje slag.', 'Studion ligger nära Medborgarplatsen och är öppen från tidig morgon till sen kväll.'] },
    { title: 'Ta med gänget — eller bara svingen', paragraphs: ['Priset gäller per simulator och timme, så kostnaden kan delas mellan spelarna. Det fungerar lika bra för ett eget träningspass som för social golf.', 'Ping G440-klubbor och bollar ingår. Begränsat antal vänster-, dam- och juniorklubbor finns på plats.'] },
  ]}
  cards={[
    { title: 'Simulatorgolf', text: 'Läs mer om teknik och spel.', label: 'Utforska studion', href: `${base}/simulatorgolf-stockholm/` },
    { title: 'Priser', text: 'Från 299 kr per simulator och timme.', label: 'Se prislistan', href: `${base}/priser/` },
    { title: 'Boka', text: 'Välj tid direkt i Sweetspot.', label: 'Se lediga tider', href: site.bookingUrl },
  ]}
  faqs={faqs}
/>
