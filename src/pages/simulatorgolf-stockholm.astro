---
import '../styles/global.css';

const sweetspotUrl = 'https://book.sweetspot.io/clubs/golfoteket/2553/tee-sheet?date=2026-08-17';
const siteUrl = 'https://aggelito.github.io/simgolf/';
const pageUrl = 'https://aggelito.github.io/simgolf/simulatorgolf-stockholm/';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'SportsActivityLocation'],
    '@id': `${siteUrl}#golfoteket`,
    name: 'Golfoteket',
    description: 'Golfoteket erbjuder simulatorgolf i Stockholm på Södermalm med 6 simulatorbanor, Trackman iO, öppet 06.00–23.00 och onlinebokning via Sweetspot.',
    url: siteUrl,
    areaServed: [
      { '@type': 'City', name: 'Stockholm' },
      { '@type': 'Place', name: 'Södermalm' },
    ],
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Stockholm',
      addressRegion: 'Stockholm',
      addressCountry: 'SE',
    },
    openingHours: 'Mo-Su 06:00-23:00',
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: 'Trackman iO', value: true },
      { '@type': 'LocationFeatureSpecification', name: '6 simulatorbanor', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Onlinebokning via Sweetspot', value: true },
    ],
    potentialAction: {
      '@type': 'ReserveAction',
      target: sweetspotUrl,
      name: 'Boka simulatorgolf i Stockholm',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Var kan man spela simulatorgolf i Stockholm?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Golfoteket på Södermalm erbjuder simulatorgolf i Stockholm med 6 simulatorbanor, Trackman iO och onlinebokning via Sweetspot.',
        },
      },
      {
        '@type': 'Question',
        name: 'Kan man träna golf inomhus på vintern i Stockholm?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Ja. Hos Golfoteket kan du träna golf inomhus året runt med Trackman iO och tydlig data på bollflykt, längd och riktning.',
        },
      },
      {
        '@type': 'Question',
        name: 'Passar simulatorgolf för grupper?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Ja. Golfoteket passar för kompisgäng, kollegor och grupper som vill spela bana, longest drive eller närmast flagg i en self-service golfstudio.',
        },
      },
    ],
  },
]);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Simulatorgolf i Stockholm — Golfoteket på Södermalm</title>
    <meta name="description" content="Letar du efter simulatorgolf i Stockholm? Golfoteket på Södermalm har 6 simulatorbanor, Trackman iO, öppet 06.00–23.00 och bokning via Sweetspot." />
    <meta name="theme-color" content="#08110c" />
    <link rel="icon" href={`${basePath}/favicon.svg`} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content="Simulatorgolf i Stockholm — Golfoteket" />
    <meta property="og:description" content="Boka simulatorgolf på Södermalm i Stockholm. 6 simulatorbanor, Trackman iO och smidig bokning via Sweetspot." />
    <meta property="og:type" content="website" />
    <script is:inline type="application/ld+json" set:html={schema}></script>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', storedTheme ? storedTheme === 'dark' : prefersDark);
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${basePath}/`} aria-label="Golfoteket startsida">
        <span class="brand-mark">G</span>
        <span>Golfoteket</span>
      </a>
      <nav aria-label="Huvudmeny">
        <a href={`${basePath}/simulatorgolf-stockholm/`}>Simulatorgolf</a>
        <a href={`${basePath}/golftraning-vinter/`}>Vinterträning</a>
        <a href={`${basePath}/priser/`}>Priser</a>
        <a href={`${basePath}/sa-funkar-det/`}>Så funkar det</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Växla mellan mörkt och ljust läge">Mörkt</button>
        <a class="nav-cta" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka nu</a>
      </nav>
    </header>

    <main id="top" class="seo-page">
      <section class="seo-hero section-shell">
        <p class="eyebrow">Simulatorgolf Stockholm</p>
        <h1>Simulatorgolf i Stockholm — boka på Södermalm.</h1>
        <p class="hero-lead">Golfoteket är en stilren self-service golfstudio på Södermalm i Stockholm med 6 simulatorbanor, Trackman iO och öppet 06.00–23.00. Boka online via Sweetspot och spela när det passar dig.</p>
        <div class="hero-actions">
          <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka simulatorgolf</a>
          <a class="button secondary" href={`${import.meta.env.BASE_URL}/#boka`}>Se startsidan</a>
        </div>
      </section>

      <section class="ai-facts section-shell" aria-label="Sammanfattning">
        <p class="eyebrow">Kort svar</p>
        <h2>Var kan man spela simulatorgolf i Stockholm?</h2>
        <p>Du kan spela simulatorgolf hos Golfoteket på Södermalm i Stockholm. Golfoteket erbjuder 6 simulatorbanor, Trackman iO, onlinebokning via Sweetspot och öppettider 06.00–23.00 för träning, rundor och kompisgolf året runt.</p>
      </section>

      <section class="seo-content section-shell">
        <article>
          <h2>Indoor golf för träning, runda eller kompisgolf</h2>
          <p>Simulatorgolf passar både dig som vill hålla igång svingen under vintern och dig som vill spela en runda utan väderstrul. Hos Golfoteket bokar du en simulator per timme och använder tiden för träning, banor, longest drive, närmast flagg eller social golf med vänner.</p>
          <p>Studion är byggd för att vara smidig: boka online, få instruktioner för access och spela under din bokade tid. Fokus ligger på golf, data och en lugnare studiokänsla.</p>
        </article>
        <article>
          <h2>Trackman iO och 6 simulatorbanor på Södermalm</h2>
          <p>Golfoteket använder Trackman iO för tydlig feedback på bollflykt, längd och riktning. Det gör lokalen relevant både för seriös golfträning och för grupper som vill ha en rolig golfaktivitet i Stockholm.</p>
          <p>Med placering på Södermalm är Golfoteket ett lokalt alternativ för dig som söker simulatorgolf i Stockholm, indoor golf i Stockholm eller golfträning inomhus under vinterhalvåret.</p>
        </article>
      </section>

      <section class="feature-grid section-shell" aria-label="Därför väljer golfare Golfoteket">
        <article>
          <h3>För träning året runt</h3>
          <p>Håll igång svingen när banorna är stängda och använd Trackman-data för att se vad som faktiskt händer.</p>
          <a href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka träningstid →</a>
        </article>
        <article>
          <h3>För kompisgäng</h3>
          <p>Spela bana, kör longest drive eller närmast flagg. Enkelt att boka och lätt att dela kostnaden.</p>
          <a href={`${import.meta.env.BASE_URL}/#grupp`}>Läs om grupper →</a>
        </article>
        <article>
          <h3>För lokal golf i Stockholm</h3>
          <p>Södermalm, öppet 06.00–23.00, onlinebokning och self-service access när du vill spela.</p>
          <a href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Se lediga tider →</a>
        </article>
      </section>

      <section class="faq section-shell">
        <p class="eyebrow">FAQ</p>
        <details open>
          <summary>Var ligger Golfoteket?</summary>
          <p>Golfoteket ligger på Södermalm i Stockholm. Exakt adress bör läggas till när den ska publiceras skarpt.</p>
        </details>
        <details>
          <summary>Har Golfoteket Trackman?</summary>
          <p>Ja. Golfoteket använder Trackman iO för simulatorgolf och golfträning.</p>
        </details>
        <details>
          <summary>Hur bokar man simulatorgolf i Stockholm hos Golfoteket?</summary>
          <p>Du bokar online via Sweetspot, väljer tid och simulator och följer accessinstruktionerna för din bokade tid.</p>
        </details>
      </section>

      <section class="final-cta section-shell">
        <p class="eyebrow">Boka simulatorgolf Stockholm</p>
        <h2>Se lediga tider hos Golfoteket.</h2>
        <p>Simulatorgolf på Södermalm med Trackman iO, 6 simulatorbanor och bokning via Sweetspot.</p>
        <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka i Sweetspot</a>
      </section>
    </main>

    <footer>
      <strong>Golfoteket</strong>
      <span>Simulatorgolf i Stockholm — Södermalm, öppet 06.00–23.00.</span>
    </footer>
    <script is:inline>
      const toggle = document.querySelector('[data-theme-toggle]');
      const setLabel = () => {
        if (toggle) toggle.textContent = document.documentElement.classList.contains('dark') ? 'Ljust' : 'Mörkt';
      };
      setLabel();
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        setLabel();
      });
    </script>
  </body>
</html>
