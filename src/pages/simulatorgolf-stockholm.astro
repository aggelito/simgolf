---
import SeoLanding from '../components/SeoLanding.astro';
import { site } from '../data/golfoteket';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faqs = [
  ['Var ligger Golfoteket?', 'Golfoteket ligger på Åsögatan 87, 118 29 Stockholm, nära Medborgarplatsen på Södermalm.'],
  ['Har Golfoteket Trackman?', 'Ja. Alla 6 simulatorer använder Trackman iO med 4K laserprojektor, analysskärm och 27-tums kontrollskärm.'],
  ['Hur bokar jag?', 'Boka direkt via Sweetspot. Du får dörrkod tillsammans med bokningen.'],
];
---
<SeoLanding
  title="Simulatorgolf i Stockholm — Golfoteket på Södermalm"
  description="Golfoteket öppnar 17 augusti på Åsögatan 87. Boka 6 Trackman iO-simulatorer 06–23 varje dag; klubbor och bollar ingår."
  path="simulatorgolf-stockholm/"
  eyebrow="Simulatorgolf Stockholm"
  heading="Simulatorgolf mitt på Södermalm."
  lead="Spela bana, träna eller samla vännerna i sex Trackman iO-simulatorer på Åsögatan 87. Öppnar 17 augusti, därefter tider 06–23 varje dag."
  answerHeading="Var kan man spela simulatorgolf i Stockholm?"
  answer="Hos Golfoteket på Södermalm spelar du simulatorgolf med Trackman iO, 4K-projektion och utrustning på plats. Studion öppnar 17 augusti 2026 och bokas online via Sweetspot."
  articles={[
    { title: 'För rundan och träningspasset', paragraphs: ['Välj mellan virtuella banor, fokuserad slagträning eller enkla tävlingar. Trackman iO ger direkt återkoppling på varje slag.', 'Ping G440-klubbor och bollar ingår, så du kan komma som du är. Vänster-, dam- och juniorklubbor finns i begränsat antal.'] },
    { title: 'Enkelt från bokning till utslag', paragraphs: ['Golfoteket är en self-serviceanläggning. Välj tid i Sweetspot och få dörrkoden tillsammans med bokningen.', 'Priset gäller per simulator och timme: från 299 kr på vardagar och 399 kr kvällar och helger.'] },
  ]}
  cards={[
    { title: 'Vinterträning', text: 'Håll svingen levande året runt.', label: 'Läs om vinterträning', href: `${base}/golftraning-vinter/` },
    { title: 'Så fungerar det', text: 'Bokning, dörrkod och utrustning.', label: 'Inför besöket', href: `${base}/sa-funkar-det/` },
    { title: 'Boka en tid', text: 'Se lediga simulatorer i Sweetspot.', label: 'Till bokningen', href: site.bookingUrl },
  ]}
  faqs={faqs}
/>
