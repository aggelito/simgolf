---
import SeoLanding from '../components/SeoLanding.astro';
import { site } from '../data/golfoteket';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faqs = [
  ['Kan man träna golf på vintern?', 'Ja. Golfoteket är en inomhusstudio där du kan träna året runt med Trackman iO.'],
  ['Vad kan jag följa i Trackman?', 'Trackman iO ger återkoppling på bland annat bollflykt, längd och riktning.'],
  ['Måste jag ha egna klubbor?', 'Nej. Ping G440-klubbor och bollar ingår, men du får gärna ta med egna klubbor.'],
];
---
<SeoLanding
  title="Golfträning vinter i Stockholm — träna hos Golfoteket"
  description="Vinterträna golf inomhus på Södermalm med Trackman iO. Golfoteket öppnar 17 augusti med 6 simulatorer, tider 06–23 och Ping G440-klubbor som ingår."
  path="golftraning-vinter/"
  eyebrow="Golfträning vinter"
  heading="Låt inte vintern ta svingen."
  lead="Träna med tydlig data i Trackman iO och bygg en jämn rutin hela året. Golfoteket öppnar 17 augusti och har därefter öppet 06–23 varje dag."
  answerHeading="Var kan man vinterträna golf i Stockholm?"
  answer="På Golfoteket på Åsögatan 87 kan du träna golf inomhus i 6 Trackman iO-simulatorer. Boka en timme i Sweetspot, få din dörrkod och träna när det passar."
  articles={[
    { title: 'Feedback som gör passet värdefullt', paragraphs: ['Trackman iO hjälper dig följa bollflykt, längd och riktning. Lägg passet på wedgekontroll, driver, järnslag eller spel på bana.', 'Varje simulator har 4K laserprojektor, analysskärm och 27-tums kontrollskärm för en smidig träningsmiljö.'] },
    { title: 'Gör träningen till en vana', paragraphs: ['Från öppningen 17 augusti finns tider 06 på morgonen till 23 på kvällen, vilket gör det lättare att få in ett pass före eller efter jobbet.', 'Medlemskap gäller i ett år och ger fria timmar samt rabatt. Klippkort finns också via Sweetspot.'] },
  ]}
  cards={[
    { title: 'Medlemskap & pris', text: 'Jämför timpris och rabatter.', label: 'Se alla priser', href: `${base}/priser/` },
    { title: 'Så fungerar det', text: 'Från bokning till dörrkod.', label: 'Läs guiden', href: `${base}/sa-funkar-det/` },
    { title: 'Boka träning', text: 'Välj nästa tid i Sweetspot.', label: 'Till bokningen', href: site.bookingUrl },
  ]}
  faqs={faqs}
/>
