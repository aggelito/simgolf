---
import SeoLanding from '../components/SeoLanding.astro';
import { site } from '../data/golfoteket';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faqs = [
  ['Är Golfoteket bemannat?', 'Nej. Golfoteket är en self-serviceanläggning och dörrkoden skickas med bokningen.'],
  ['Finns utrustning på plats?', 'Ja. Ping G440-klubbor och bollar ingår. Vänster-, dam- och juniorklubbor finns i begränsat antal.'],
  ['Vilka öppettider gäller?', 'Golfoteket öppnar 17 augusti 2026 och har därefter öppet 06–23 varje dag.'],
];
---
<SeoLanding
  title="Så fungerar Golfoteket — boka simulatorgolf på Södermalm"
  description="Golfoteket öppnar 17 augusti. Boka i Sweetspot, få dörrkod och spela 06–23 varje dag med Ping G440-klubbor som ingår."
  path="sa-funkar-det/"
  eyebrow="Så fungerar det"
  heading="Boka. Kom in. Spela."
  lead="Golfoteket är byggt för enkel golf på dina tider. Välj simulator online, få din dörrkod och spela under den bokade tiden."
  answerHeading="Hur fungerar bokning hos Golfoteket?"
  answer="Boka en simulator direkt i Sweetspot. Dörrkoden skickas med bokningen till den obemannade studion på Åsögatan 87. Klubbor och bollar finns på plats."
  articles={[
    { title: '1. Boka och få din dörrkod', paragraphs: ['Välj datum, tid och simulator i Sweetspot. Kontrollera bokningen och använd koden du får för att komma in i lokalen.', 'Priset gäller per simulator och timme. Boka tillräckligt med tid om ni är flera och vill spela en längre runda.'] },
    { title: '2. Spela och lämna snyggt', paragraphs: ['Din simulator har Trackman iO, 4K-projektion, analysskärm och kontrollskärm. Ping G440-klubbor och bollar ingår.', 'Avsluta i tid, ställ tillbaka lånad utrustning och lämna platsen redo för nästa spelare.'] },
  ]}
  cards={[
    { title: 'Boka tid', text: 'Se lediga simulatorer online.', label: 'Öppna Sweetspot', href: site.bookingUrl },
    { title: 'Priser', text: 'Från 299 kr per simulator och timme.', label: 'Se prislistan', href: `${base}/priser/` },
    { title: 'Hitta hit', text: 'Åsögatan 87, nära Medborgarplatsen.', label: 'Öppna kartan', href: site.mapsUrl },
  ]}
  faqs={faqs}
/>
