---
import '../styles/global.css';

const sweetspotUrl = 'https://book.sweetspot.io/clubs/indoor-golf-group/961/tee-sheet';
const siteUrl = 'https://aggelito.github.io/simgolf/';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');

const pageUrl = 'https://aggelito.github.io/simgolf/sa-funkar-det/';
const schema = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': ['LocalBusiness', 'SportsActivityLocation'],
    '@id': `${siteUrl}#golfoteket`,
    name: 'Golfoteket',
    description: 'Golfoteket är en self-service simulatorgolfstudio på Södermalm där kunder bokar online via Sweetspot, följer accessinstruktioner och spelar under sin bokade tid.',
    url: siteUrl,
    areaServed: [{ '@type': 'City', name: 'Stockholm' }, { '@type': 'Place', name: 'Södermalm' }],
    address: { '@type': 'PostalAddress', addressLocality: 'Stockholm', addressRegion: 'Stockholm', addressCountry: 'SE' },
    openingHours: 'Mo-Su 06:00-23:00',
    amenityFeature: [
      { '@type': 'LocationFeatureSpecification', name: '6 simulatorbanor', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Trackman iO', value: true },
      { '@type': 'LocationFeatureSpecification', name: 'Onlinebokning via Sweetspot', value: true },
    ],
    potentialAction: { '@type': 'ReserveAction', target: sweetspotUrl, name: 'Boka hos Golfoteket' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: 'Så fungerar Golfoteket — boka simulatorgolf på Södermalm',
    description: 'Så fungerar Golfoteket: boka simulatorgolf online via Sweetspot, följ accessinstruktioner och spela i self-service golfstudio på Södermalm.',
    inLanguage: 'sv-SE',
    about: { '@id': `${siteUrl}#golfoteket` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'Är lokalen bemannad?',
        acceptedAnswer: { '@type': 'Answer', text: 'Upplägget är self-service. Du bokar tid, får accessinstruktioner och spelar under din bokade tid.' },
      },
      {
        '@type': 'Question',
        name: 'Finns utrustning?',
        acceptedAnswer: { '@type': 'Answer', text: 'Standardset från Callaway och Titleist Pro V1 WHT-bollar finns kostnadsfritt på plats enligt nuvarande upplägg.' },
      },
      {
        '@type': 'Question',
        name: 'Vad gör jag när jag är klar?',
        acceptedAnswer: { '@type': 'Answer', text: 'Avsluta i tid, ställ tillbaka utrustning och lämna studion snygg för nästa spelare.' },
      },
    ],
  },
]);
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Så fungerar Golfoteket — boka simulatorgolf på Södermalm</title>
    <meta name="description" content="Så fungerar Golfoteket: boka simulatorgolf online via Sweetspot, följ accessinstruktioner och spela i self-service golfstudio på Södermalm." />
    <meta name="theme-color" content="#08110c" />
    <link rel="icon" href={`${basePath}/favicon.svg`} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:title" content="Så fungerar Golfoteket — boka simulatorgolf på Södermalm" />
    <meta property="og:description" content="Så fungerar Golfoteket: boka simulatorgolf online via Sweetspot, följ accessinstruktioner och spela i self-service golfstudio på Södermalm." />
    <meta property="og:type" content="website" />
    <script is:inline type="application/ld+json" set:html={schema}></script>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      document.documentElement.classList.toggle('dark', storedTheme ? storedTheme === 'dark' : prefersDark);
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${basePath}/`} aria-label="Golfoteket startsida">
        <span class="brand-name">Golfoteket</span>
        <span class="brand-tag">Golf i alla väder</span>
      </a>
      <nav aria-label="Huvudmeny">
        <a href={`${basePath}/simulatorgolf-stockholm/`}>Simulatorgolf</a>
        <a href={`${basePath}/golftraning-vinter/`}>Vinterträning</a>
        <a href={`${basePath}/priser/`}>Priser</a>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Växla mellan mörkt och ljust läge">Mörkt</button>
        <a class="nav-cta" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka</a>
      </nav>
    </header>

    <main id="top" class="seo-page">
      <section class="seo-hero section-shell">
        <p class="eyebrow">Så fungerar det</p>
        <h1>Boka. Kom in. Spela.</h1>
        <p class="hero-lead">Golfoteket är gjort för att vara enkelt: boka online, följ accessinstruktionerna och använd studion under din tid. Inget onödigt krångel.</p>
        <div class="hero-actions">
          <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Boka i Sweetspot</a>
          <a class="button secondary" href={`${basePath}/sa-funkar-det/`}>Så fungerar det</a>
        </div>
      </section>

      <section class="ai-facts section-shell" aria-label="Sammanfattning">
        <p class="eyebrow">Kort svar</p>
        <h2>Hur fungerar bokning hos Golfoteket?</h2>
        <p>Du bokar simulatorgolf hos Golfoteket online via Sweetspot, får accessinstruktioner för din bokade tid och spelar i en self-service golfstudio på Södermalm i Stockholm.</p>
      </section>

      <section class="seo-content section-shell">
        <article>
          <h2>1. Boka online</h2>
          <p>Välj tid och simulator i Sweetspot. Bokningen är grunden, så kontrollera tid, datum och antal simulatorer innan ni kommer.</p>
          <p>Boka hellre lite mer tid om ni är många eller vill spela bana i lugnare tempo.</p>
        </article>
        <article>
          <h2>2. Följ access och spela snyggt</h2>
          <p>Golfoteket är self-service. Följ instruktionerna du får för access, använd simulatorn under din bokade tid och lämna studion redo för nästa spelare.</p>
          <p>Klubbor och bollar finns på plats enligt nuvarande upplägg. Ta gärna med egna klubbor om du vill träna specifikt.</p>
        </article>
      </section>

      <section class="feature-grid section-shell" aria-label="Snabba val">
        <article>
          <h3>Boka tid</h3>
          <p>Öppna Sweetspot och välj tid som passar.</p>
          <a href={sweetspotUrl}>Boka nu →</a>
        </article>
        <article>
          <h3>Se priser</h3>
          <p>Förstå timpris och bästa tiderna att boka.</p>
          <a href={`${basePath}/priser/`}>Se priser →</a>
        </article>
        <article>
          <h3>Träna vintertid</h3>
          <p>Använd studion för mer än social golf.</p>
          <a href={`${basePath}/golftraning-vinter/`}>Golfträning vinter →</a>
        </article>
      </section>

      <section class="faq section-shell">
        <p class="eyebrow">FAQ</p>
        <details open>
          <summary>Är lokalen bemannad?</summary>
          <p>Upplägget är self-service. Du bokar tid, får accessinstruktioner och spelar under din bokade tid.</p>
        </details>
        <details >
          <summary>Finns utrustning?</summary>
          <p>Standardset från Callaway och Titleist Pro V1 WHT-bollar finns kostnadsfritt på plats enligt nuvarande upplägg.</p>
        </details>
        <details >
          <summary>Vad gör jag när jag är klar?</summary>
          <p>Avsluta i tid, ställ tillbaka utrustning och lämna studion snygg för nästa spelare.</p>
        </details>
      </section>

      <section class="final-cta section-shell">
        <p class="eyebrow">Redo att spela?</p>
        <h2>Boka en tid hos Golfoteket.</h2>
        <p>Simulatorgolf på Södermalm med Trackman iO, 6 simulatorbanor och enkel bokning via Sweetspot.</p>
        <a class="button primary" href={sweetspotUrl} target="_blank" rel="noopener noreferrer">Se lediga tider</a>
      </section>
    </main>

    <footer>
      <strong>Golfoteket</strong>
      <span>Simulatorgolf på Södermalm — öppet 06.00–23.00.</span>
    </footer>
    <script is:inline>
      const toggle = document.querySelector('[data-theme-toggle]');
      const setLabel = () => {
        if (toggle) toggle.textContent = document.documentElement.classList.contains('dark') ? 'Ljust' : 'Mörkt';
      };
      setLabel();
      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        setLabel();
      });
    </script>
  </body>
</html>
