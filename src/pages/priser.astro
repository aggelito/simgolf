---
import SeoLanding from '../components/SeoLanding.astro';
import { site } from '../data/golfoteket';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const faqs = [
  ['Är priset per person?', 'Nej. Priset är per simulator och timme, så ni kan dela kostnaden.'],
  ['Vilka medlemskap finns?', 'Platinum kostar 2 495 kr, Guld 1 250 kr och Silver 995 kr. Alla gäller i ett år.'],
  ['Kan jag använda friskvårdsbidrag?', 'Ja. Simulatorgolf hos Golfoteket är godkänt som friskvård.'],
];
---
<SeoLanding
  title="Priser simulatorgolf Stockholm — Golfoteket"
  description="Se timpriser, medlemskap, klippkort och öppningserbjudanden hos Golfoteket. Simulatorgolf från 299 kr per simulator och timme."
  path="priser/"
  eyebrow="Priser & medlemskap"
  heading="Mer golf. Tydliga priser."
  lead="Boka per simulator och timme, välj ett medlemskap eller köp klippkort. Aktiviteten är godkänd som friskvård."
  answerHeading="Vad kostar simulatorgolf hos Golfoteket?"
  answer="Vardagar 06–14 kostar en simulator 299 kr per timme. Vardagar 14–23 och hela helgen är priset 399 kr. Priset gäller simulatorn, inte varje spelare."
  articles={[
    { title: 'Timpriser och öppningserbjudande', paragraphs: ['Mån–fre 06–14: 299 kr. Mån–fre 14–23: 399 kr. Lör–sön hela dagen: 399 kr.', 'Till 1 oktober kan du bli medlem för 1 kr och spela första timmen för 99 kr. Ett 10-timmarspass kostar 1 995 kr och ett 5-timmarspass 1 295 kr.'] },
    { title: 'Medlemskap för hela året', paragraphs: ['Platinum: 2 495 kr med 5 fria timmar och 20% rabatt. Guld: 1 250 kr med 3 fria timmar och 15% rabatt.', 'Silver: 995 kr med 2 fria timmar och 10% rabatt. Alla medlemskap gäller ett år. Personligt skåp kostar 1 995 kr per år.'] },
  ]}
  cards={[
    { title: 'Medlemskap', text: 'Välj nivå direkt i Sweetspot.', label: 'Se medlemskap', href: site.membershipsUrl },
    { title: 'Klippkort', text: 'Flexibla pass för fler rundor.', label: 'Se tillgängliga pass', href: site.passesUrl },
    { title: 'Så fungerar det', text: 'Bokning, access och utrustning.', label: 'Inför besöket', href: `${base}/sa-funkar-det/` },
  ]}
  faqs={faqs}
/>
